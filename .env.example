# =====================================================================
# Modular-NeuroClips Studio - Environment Configuration (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Device Execution Mode
# ---------------------------------------------------------------------
# Set to 'cpu' for standard CPU VPS instances (e.g., 4-8 vCPU, 16-32GB RAM).
# When set to 'cpu', the studio automatically uses:
#   - Pollinations Flux/Turbo cloud keyframe synthesis
#   - FFmpeg subpixel Ken Burns motion clips
#   - Zero-VRAM Edge-TTS neural audio synthesis
# Set to 'cuda' only if a dedicated NVIDIA GPU with >=16GB VRAM is available.
DEVICE=cpu

# ---------------------------------------------------------------------
# 2. Local / Remote LLM Orchestration (Ollama)
# ---------------------------------------------------------------------
# Base URL for Ollama instance. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# LLM model tag for script orchestration (e.g., llama3.1:8b, llama3:latest, mistral:7b)
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------
# 3. Local Diffusion Models (Only applicable when DEVICE=cuda)
# ---------------------------------------------------------------------
T2I_MODEL=runwayml/stable-diffusion-v1-5
I2V_MODEL=THUDM/CogVideoX-2b-I2V

# ---------------------------------------------------------------------
# 4. Default Video Canvas Dimensions
# ---------------------------------------------------------------------
# Supported: 1280x720 (HD), 576x320 (SD Fast Preview), 1920x1080 (FHD), 720x1280 (9:16 Shorts)
RENDER_WIDTH=1280
RENDER_HEIGHT=720

# ---------------------------------------------------------------------
# 5. Output & Cache Directories
# ---------------------------------------------------------------------
OUTPUT_DIR=./render_output
CURRICULUM_OUTPUT_DIR=./curriculum_output
EXPORTS_DIR=./exports

# ---------------------------------------------------------------------
# 6. Web Dashboard Server Binding
# ---------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
